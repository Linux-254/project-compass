# ReForge (Project Compass) environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Database (Supabase / PostgreSQL) ----------------------------------------
# Connection string for the Postgres database (Supabase pooler or direct).
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# --- Authentication / OAuth (Manus auth portal) ------------------------------
# The Manus application id (appId). Must match the OAuth portal app.
VITE_APP_ID=your-app-id
# The Manus OAuth portal base URL (no trailing slash).
VITE_OAUTH_PORTAL_URL=https://auth.manus.space
# The OAuth server RPC base URL used by the SDK (no trailing slash).
OAUTH_SERVER_URL=https://auth.manus.space
# JWT secret used to sign session cookies. Use a long random string (>= 32 chars).
JWT_SECRET=change-me-to-a-long-random-string

# --- Roles / admin ------------------------------------------------------------
# The openId of the platform owner, promoted to the `admin` role automatically.
OWNER_OPEN_ID=

# --- Security hardening -------------------------------------------------------
# Comma-separated list of allowed browser origins for CORS (same-origin by default).
# Example: CORS_ORIGINS=https://reforge.app,https://staging.reforge.app
CORS_ORIGINS=
# Enable strict security headers / CSP (helmet). "1" to enable.
SECURITY_HEADERS=1
# Optional 32-byte base64 key for Tier-1 data encryption.
# When unset, a key is derived from JWT_SECRET.
ENCRYPTION_KEY=

# --- Server ------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Optional: Manus heartbeat / scheduled jobs (newsletter dispatch) --------
# BUILT_IN_FORGE_API_URL=https://...
# BUILT_IN_FORGE_API_KEY=
